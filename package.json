{
  "name": "diario-trader",
  "version": "600.0.0",
  "private": true,
  "scripts": {
    "build": "npm run bundle && node scripts/build.cjs",
    "build:check": "node scripts/generate-bundles.cjs --check && node scripts/build.cjs --check",
    "check": "npm run build:check && node scripts/check-backend.cjs",
    "test": "node --test tests/*.test.cjs test-*.cjs",
    "verify": "npm run check && npm test",
    "bundle": "node scripts/generate-bundles.cjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "fake-indexeddb": "6.0.0",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "terser": "5.44.0"
  }
}
