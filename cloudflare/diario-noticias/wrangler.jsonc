{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "diario-trader",
  "main": "producao-snapshot-v894.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://meudiariotrade.github.io"
  },
  "kv_namespaces": [
    {
      "binding": "NEWS_CACHE",
      "id": "6fbbde51848b47919b38de922f6c0362"
    }
  ],
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "HISTORICO",
      "database_name": "diario-mercado-historico",
      "database_id": "af90d130-db64-40ba-96e3-77a5a0c81ce5"
    }
  ],
  "ratelimits": [
    {
      "name": "REPLAY_LIMIT",
      "namespace_id": "89101",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ]
}
